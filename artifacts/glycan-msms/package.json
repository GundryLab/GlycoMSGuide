    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "tsx --test scripts/validateDiagnosticIons.test.ts scripts/diagnosticIonsIntegrity.test.ts src/data/compositionConfusions.test.ts src/components/SNFGSymbols.test.tsx src/data/monosaccharideExports.test.ts src/data/glycanDrawingTools.test.ts scripts/generateMonosaccharideSourceCandidates.test.ts",
