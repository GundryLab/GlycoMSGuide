    "test:composition-confusions": "tsx --test src/data/compositionConfusions.test.ts",
    "test:snfg": "tsx --test src/components/SNFGSymbols.test.tsx",
    "validate:monosaccharides": "tsx scripts/validateMonosaccharidesData.ts",
    "sources:monosaccharides": "tsx scripts/generateMonosaccharideSourceCandidates.ts",
    "test:sources:monosaccharides": "tsx --test scripts/generateMonosaccharideSourceCandidates.test.ts",
    "validate:diagnostic-ions": "tsx scripts/validateDiagnosticIons.ts",
    "test:diagnostic-ions": "tsx --test scripts/validateDiagnosticIons.test.ts scripts/diagnosticIonsIntegrity.test.ts",
    "build:diagnostic-ions-json": "tsx scripts/writeDiagnosticIonsJson.ts",
    "update-monosaccharide-source-data": "tsx ./scripts/updateMonosaccharideSourceData.ts"
  },
